# Kestrel Desk configuration. Copy to .env and fill in. .env is git-ignored; never commit a key.
# Pointing the harness at a different model provider means editing THIS file only.

# --- The model endpoint (the portability seam) --------------------------------------------
# Any OpenAI-compatible chat-completions base URL. Default: Anthropic's OpenAI-compatible endpoint.
# Org laptop example: LLM_BASE_URL=https://llm-gateway.internal.example/v1/
LLM_BASE_URL=https://api.anthropic.com/v1/

# Bearer key for that endpoint. If empty, ANTHROPIC_API_KEY and then OPENAI_API_KEY are tried.
# Without any key, tests, the CLI's --help and the web UI's meta still work; model calls fail.
LLM_API_KEY=

# Main agent model id, as the endpoint names it.
LLM_MODEL=claude-opus-5-5

# Cheaper model for subagents (proposal-reviewer). Use the same id as LLM_MODEL if your
# endpoint serves only one model.
LLM_SUBAGENT_MODEL=claude-sonnet-5-5

# Max output tokens per model call.
LLM_MAX_TOKENS=4096

# Extra HTTP headers sent on every call, as a JSON object on one line. Leave empty if unused.
# e.g. LLM_EXTRA_HEADERS={"anthropic-workspace-id": "wrkspc_..."}
#  or  LLM_EXTRA_HEADERS={"X-Team": "platform"}
LLM_EXTRA_HEADERS=

# --- Harness tuning ------------------------------------------------------------------------
# Prompt-token count that triggers context compaction (stage 4). Low on purpose so the demo shows it.
KESTREL_COMPACT_AT_TOKENS=6000

# Messages kept verbatim after compaction; older ones become one "[Conversation summary]".
KESTREL_KEEP_LAST_MESSAGES=6

# --- Web app ------------------------------------------------------------------------------
# 1 = rehearsal mode: canned meta and scripted event streams, no model calls at all.
# KESTREL_MOCK=1

# --- Network (optional, corporate laptops) ---------------------------------------------------
# The HTTP client honours these standard variables; they can live here too.
# SSL_CERT_FILE=C:\path\to\corporate-root-ca.pem
# HTTPS_PROXY=http://proxy.internal.example:8080
